{
  "id": "official.devtools",
  "name": "开发工具",
  "version": "1.0.3",
  "protocolVersion": 1,
  "executable": "devtools.exe",
  "keywords": [
    "json",
    "base64",
    "urlencode",
    "hash",
    "regex",
    "color"
  ],
  "permissions": [],
  "description": "离线文本工具：JSON 校验与格式化、Base64 与 URL 编解码、正则匹配、SHA-256/SHA-1/MD5 摘要、颜色格式转换。只做文本转换，不执行输入中的任何代码，不访问网络。时间、时间戳与 UUID 由启动器内置工具提供。",
  "commands": [
    {
      "id": "show-tools",
      "title": "打开开发工具",
      "scope": "global",
      "defaultShortcuts": [],
      "activation": "showQuery",
      "query": "json "
    }
  ],
  "icon": "assets/icon.png",
  "author": "FluentLauncher",
  "homepage": "https://github.com/FluentLauncher/FluentLauncher-plugins",
  "usage": "输入 json 加文本进行格式化；hash abc 生成摘要；color #36a 转换颜色格式。"
}
