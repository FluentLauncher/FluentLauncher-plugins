{
  "id": "official.screenshot",
  "name": "截图与贴图",
  "version": "1.3.0",
  "protocolVersion": 1,
  "executable": "screenshot.exe",
  "keywords": ["截图", "screenshot", "snap", "截屏"],
  "permissions": [],
  "description": "紧凑截图工具条：标注、马赛克、文字、撤销重做、滚动长截图、保存与贴图；主题透明菜单与像素放大镜。仅主动捕获，不上传、不留历史；文件打开或拖出时生成临时 PNG。材质同步需新版宿主。",
  "commands": [
    {"id": "region", "title": "区域截图", "scope": "global", "activation": "invoke", "defaultShortcuts": ["Ctrl+Alt+A"]},
    {"id": "region-pin", "title": "区域截图并原地贴图", "scope": "global", "activation": "invoke", "defaultShortcuts": ["Ctrl+Alt+P"]},
    {"id": "screen", "title": "当前显示器截图", "scope": "global", "activation": "invoke"},
    {"id": "show", "title": "显示全部贴图", "scope": "global", "activation": "invoke"},
    {"id": "hide", "title": "隐藏全部贴图", "scope": "global", "activation": "invoke"}
  ]
}
